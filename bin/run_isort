#!/usr/bin/env bash

configuration=$1
sort_paths=$2

# Build argument arrays to avoid unquoted word-splitting while preserving
# the ability to pass multiple flags/paths
read -ra config_args <<< "$configuration"
read -ra path_args <<< "$sort_paths"

echo "Running isort $configuration $sort_paths"
isort_result=$(isort "${config_args[@]}" "${path_args[@]}")
exit_code=$?

echo "::set-output name=isort-output::${isort_result}"
exit $exit_code
